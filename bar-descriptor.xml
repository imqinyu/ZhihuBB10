<?xml version="1.0" encoding="utf-8"?>
<qnx xmlns="http://www.qnx.com/schemas/application/1.0">
    <id>com.fremantle.Zhihu</id>
    <name>Zhihu</name>
    <versionNumber>0.3.3</versionNumber>
    <buildId>1</buildId>
    <description>Native Zhihu for BlackBerry 10</description>
    <icon>
       <image>ic_launcher.png</image>
    </icon>
    <category>core.media</category>
    <author>Fremantle</author>
    <configuration name="Device-Debug">
        <platformArchitecture>armle-v7</platformArchitecture>
        <asset path="arm/o.le-v7-g/Zhihu" entry="true" type="Qnx/Elf">Zhihu</asset>
    </configuration>
    <configuration name="Device-Release">
        <platformArchitecture>armle-v7</platformArchitecture>
        <asset path="arm/o.le-v7-g/Zhihu" entry="true" type="Qnx/Elf">Zhihu</asset>
    </configuration>
    <configuration name="Device-Profile">
        <platformArchitecture>armle-v7</platformArchitecture>
        <asset path="arm/o.le-v7-g/Zhihu" entry="true" type="Qnx/Elf">Zhihu</asset>
    </configuration>
    <configuration name="Simulator-Debug">
        <platformArchitecture>x86</platformArchitecture>
        <asset path="x86/o-g/Zhihu" entry="true" type="Qnx/Elf">Zhihu</asset>
    </configuration>
    <initialWindow><autoOrients>false</autoOrients><systemChrome>none</systemChrome>    
    <aspectRatio>portrait</aspectRatio>
</initialWindow>
    <asset path="icon.png">icon.png</asset>
    <asset path="assets">assets</asset>
    <asset path="D:/TmpDir/ic_launcher.png">ic_launcher.png</asset>
    <permission system="true">run_native</permission>
    <permission>access_internet</permission>
    <permission>access_shared</permission>
    <env var="CASCADES_THEME" value="bright?primaryColor=0x0084FF"/>
    <env var="LD_LIBRARY_PATH" value="app/native/lib:/usr/lib/qt4/lib"/>
</qnx>
